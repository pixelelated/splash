#!/usr/bin/env python3
"""Generate the lowercase wordmark from unmodified Tiny5 Duo LCD outlines.

Requires fonttools==4.66.1; source and SHA256 are recorded in fonts/README.md.
LCD cells are clipped to Ocean Bands as plain paths for limited SVG readers.
"""
import hashlib
import math
from pathlib import Path
from fontTools.pens.recordingPen import RecordingPen
from fontTools.ttLib import TTFont

root = Path(__file__).resolve().parent.parent
source = root / 'fonts/Tiny5Duo-LCD.otf'
expected = (root / 'fonts/Tiny5Duo-LCD.otf.sha256').read_text().split()[0]
assert hashlib.sha256(source.read_bytes()).hexdigest() == expected, 'font source digest differs'
font = TTFont(source)
assert font['name'].getDebugName(1) == 'Tiny5 Duo LCD'
glyphs, cmap = font.getGlyphSet(), font.getBestCmap()
# Tiny5's eight-cell em keeps existing splash sizing in pixel-cell coordinates.
unit = font['head'].unitsPerEm / 8
contours, cursor = [], 0
for char in 'pixelelated':
    name = cmap[ord(char)]
    pen = RecordingPen()
    glyphs[name].draw(pen)
    contour = []
    for operation, points in pen.value:
        if operation in ('moveTo', 'lineTo'):
            assert operation != 'moveTo' or not contour
            x, y = points[0]
            contour.append(((x + cursor) / unit, -y / unit))
        elif operation == 'closePath':
            assert len(contour) >= 3
            contours.append(contour)
            contour = []
        else:
            raise ValueError(f'unsupported font outline operation: {operation}')
    assert not contour, 'open outline'
    cursor += font['hmtx'][name][0]
left = min(x for path in contours for x, y in path)
right = max(x for path in contours for x, y in path)
top = min(y for path in contours for x, y in path)
bottom = max(y for path in contours for x, y in path)
width = math.ceil((right - left + 6) / 2) * 2
height = 32
xoff = (width - (right - left)) / 2 - left
yoff = (height - (bottom - top)) / 2 - top
# D-WORKFLOW-146: RGB555 triplets, with hard edges and no interpolated colors.
palette = [(20, 31, 31), (2, 28, 31), (2, 20, 31), (3, 12, 31), (3, 4, 22)]
colors = [tuple(round(c * 255 / 31) for c in rgb) for rgb in palette]
paths, fills = [], []
for contour in contours:
    points = [(x + xoff, y + yoff) for x, y in contour]
    xs, ys = sorted({x for x, y in points}), sorted({y for x, y in points})
    # The pinned LCD face consists entirely of rectangular cells. Refuse a
    # future outline change instead of flattening arbitrary geometry wrongly.
    assert len(points) == 4 and len(xs) == len(ys) == 2
    assert set(points) == {(x, y) for x in xs for y in ys}
    for band, color in enumerate(colors):
        low = max(ys[0], top + yoff + band * (bottom-top) / 5)
        high = min(ys[1], top + yoff + (band+1) * (bottom-top) / 5)
        if high <= low:
            continue
        clipped = [(xs[1], low), (xs[0], low), (xs[0], high), (xs[1], high)]
        paths.append(' '.join(f'{"M" if i == 0 else "L"}{x:g} {y:g}'
                              for i, (x, y) in enumerate(clipped)) + ' Z')
        fills.append(color)
svg = (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" '
       f'width="{width * 8}" height="{height * 8}" shape-rendering="crispEdges" '
       'role="img" aria-labelledby="title">\n<title id="title">pixelelated</title>\n'
       '<g id="wordmark">\n' + ''.join(
           f'<path fill="#{r:02X}{g:02X}{b:02X}" d="{p}"/>\n'
           for p, (r, g, b) in zip(paths, fills)) + '</g>\n</svg>\n')
(root / 'pixelelated-wordmark.svg').write_text(svg)
(root / 'pixelelated-wordmark.h').write_text(
    '// Generated by tools/pixelelated-wordmark; Tiny5 Duo LCD, SIL OFL 1.1.\n#pragma once\n'
    f'#define PIXELELATED_MARK_WIDTH {width}.0f\n#define PIXELELATED_MARK_HEIGHT {height}.0f\n'
    '#ifdef PIXELELATED_WORDMARK_DATA\nstatic const char *pixelelated_paths[] = {\n' +
    ''.join(f'    "{p}",\n' for p in paths) + '};\n'
    'static const char *pixelelated_fills[] = {\n' +
    ''.join(f'    "rgb({r},{g},{b})",\n' for r, g, b in fills) + '};\n#endif\n')
print(f'pixelelated: Tiny5 Duo LCD, {len(paths)} Ocean band pieces, {width}x{height} canvas')
