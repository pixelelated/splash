#!/usr/bin/env python3
"""Generate the placeholder wordmark from the unmodified Tiny5 Duo BDF."""
from pathlib import Path
r=Path(__file__).resolve().parent.parent
glyphs={}
for block in (r/'fonts/Tiny5Duo.bdf').read_text().split('STARTCHAR ')[1:]:
    lines=block.splitlines()
    value=lambda key: next(line.split()[1:] for line in lines if line.startswith(key+' '))
    code=int(value('ENCODING')[0]); advance=int(value('DWIDTH')[0])
    width,height,left,bottom=map(int,value('BBX'))
    bitmap=lines[lines.index('BITMAP')+1:lines.index('ENDCHAR')]
    pixels=[]
    for row,bits in enumerate(bitmap):
        number=int(bits,16); padded=len(bits)*4
        for col in range(width):
            if number & (1 << (padded-col-1)): pixels.append((left+col,-bottom-height+1+row))
    glyphs[code]=(advance,pixels)
pixels=[]; cursor=0
for char in 'rasteratops':
    advance,shape=glyphs[ord(char)]
    pixels.extend((cursor+x,y) for x,y in shape); cursor+=advance
left=min(x for x,y in pixels); top=min(y for x,y in pixels)
pixels=sorted(set((x-left,y-top) for x,y in pixels))
width=max(x for x,y in pixels)+1; height=max(y for x,y in pixels)+1
assert (width,height)==(57,6), (width,height)
# The even canvas keeps quarter-turn rotation on integer cell coordinates.
pixels=[(x+3,y+13) for x,y in pixels]
paths=[f'M{x} {y} L{x+1} {y} L{x+1} {y+1} L{x} {y+1} Z' for x,y in pixels]
(r/'rasteratops-wordmark.svg').write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 32" width="640" height="320">\n<title>rasteratops</title>\n<g fill="#e6e6e6" shape-rendering="crispEdges">\n'+''.join(f'<path d="{p}"/>\n' for p in paths)+'</g>\n</svg>\n')
(r/'rasteratops-wordmark.h').write_text('// Generated by tools/rasteratops-wordmark; Tiny5 Duo, SIL OFL1.1.\n#pragma once\n#define RASTERATOPS_MARK_WIDTH 64.0f\n#define RASTERATOPS_MARK_HEIGHT 32.0f\n#ifdef RASTERATOPS_WORDMARK_DATA\nstatic const char *rasteratops_paths[] = {\n'+''.join(f'    "{p}",\n' for p in paths)+'};\n#endif\n')
print(f'wordmark: {width}x{height} cells, {len(paths)} filled cells, 64x32 canvas')
